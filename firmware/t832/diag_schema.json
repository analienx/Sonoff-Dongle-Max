    "8": "NPI_RX_OVERFLOW",
    "9": "NPI_WRITE_REJECT",
    "10": "NPI_TX_FINISHED",
    "11": "TASK_SCHEDULE",
    "12": "TASK_WORK",
    "13": "STARTUP_FROM_APP_ENTRY",
    "14": "STARTUP_BDB_REQUEST",
    "15": "STARTUP_BDB_RETURN",
    "16": "STARTUP_SRSP_QUEUE",
    "17": "BDB_DISPATCH",
    "18": "BDB_RETURN",
    "19": "HEALTH",
    "20": "RESOURCE",
