{
  "schema": 1,
  "prefix": "T832D1:",
  "encoding": "hex of packed little-endian packet",
  "outer_transport": {
    "znp_type": "AREQ",
    "subsystem": "DEBUG",
    "command": "DEBUG.msg",
    "max_payload_bytes": 240
  },
  "packet": [
    ["magic", "4 bytes", "T8D1"],
    ["schema", "u8", 1],
    ["packet_kind", "u8", "1=record,2=capability"],
    ["export_sequence", "u16", "monotonic per boot"],
    ["boot_session", "u16", "firmware-local slot; host collector establishes reboot association from sequence and uptime"],
    ["uptime_ms", "u64", "extended ClockP hardware time"],
    ["firmware_revision", "u32", "CODE_REVISION_NUMBER"],
    ["capability_bitmap", "u32", "supported runtime hooks"],
    ["critical_overwrite", "u16", "critical recorder overwrite count"],
    ["routine_overwrite", "u16", "routine recorder overwrite count"],
    ["export_skipped", "u16", "backpressure/sync/pending skips"],
    ["record", "20 bytes", "T832DiagRecord"]
  ],
  "record": [
    ["first_ms", "u32", "first occurrence low 32 bits"],
    ["last_ms", "u32", "last occurrence low 32 bits"],
    ["sequence", "u16", "record sequence"],
    ["kind", "u8", "event kind"],
    ["flags", "u8", "critical/routine flags"],
    ["a", "u16", "event-specific"],
    ["b", "u16", "event-specific"],
    ["c", "u16", "event-specific"],
    ["repeat_count", "u16", "coalesced repeat count"]
